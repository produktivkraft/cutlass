{
  "version": 8,
  "configurePresets": [
    {
      "name": "osx",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/bin",
        "CUTLASS_ENABLE_HEADERS_ONLY": true,
        "CUTLASS_ENABLE_TOOLS": true,
        "CUTLASS_ENABLE_LIBRARY": false,
        "CUTLASS_ENABLE_PROFILER": false,
        "CUTLASS_ENABLE_TESTS": false,
        "CUTLASS_ENABLE_EXAMPLES": true,
        "CUTLASS_NVCC_ARCHS": "90"
      }
    },
    {
      "name": "osx_clang",
      "description": "not work",
      "binaryDir": "${sourceDir}/build_clang",
      "inherits": "min",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_LINKER_TYPE": "LLD",
        "CUDA_COMPILER": "clang"
      }
    }
  ]
}
